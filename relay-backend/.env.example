# SQLite for local dev. For Render production use a PostgreSQL URL.
DATABASE_URL=sqlite:///./relay.db

# Gemini (never exposed to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional backend-only GitHub token (raises rate limits). Never sent to the browser.
GITHUB_TOKEN=

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173